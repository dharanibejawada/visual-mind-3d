# ========================================================
# VisualMind 3D - Environment Variables Configuration (Template)
# ========================================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# If left blank, VisualMind 3D runs in Demo & Offline Mode with pre-configured high-fidelity lessons!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase Configuration (Optional - for persistent cloud storage and authentication)
# If left blank, VisualMind 3D uses Guest Mode with Local Storage persistence!
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
